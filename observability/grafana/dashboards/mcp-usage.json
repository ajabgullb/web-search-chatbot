          "expr": "sort_desc(sum by (mcp_server) (increase(mcp_server_startup_milliseconds_sum{job=\"mcp\",mcp_server=~\"$server\"}[$__range])) / sum by (mcp_server) (increase(mcp_server_startup_milliseconds_count{job=\"mcp\",mcp_server=~\"$server\"}[$__range])))",
