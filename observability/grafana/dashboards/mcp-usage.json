    {
      "type": "timeseries",
      "title": "Call duration p95 by server",
      "description": "How long calls take as Claude Code measures them, including the trip to the server. Browser calls are naturally slower (seconds); SQL and PromQL should stay well under one.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, mcp_server) (rate(mcp_tool_duration_milliseconds_bucket{job=\"mcp\",mcp_server=~\"$server\"}[$__rate_interval])))",
          "legendFormat": "{{mcp_server}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "min": 0
        },
