    {
      "type": "timeseries",
      "title": "Failed calls per minute by tool",
      "description": "Failed calls over time. A burst on one tool usually means its backend went away: Postgres or Prometheus stopped, or the web app isn't running for Playwright.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (mcp_server, mcp_tool) (rate(mcp_tool_calls_total{job=\"mcp\",success=\"false\",mcp_server=~\"$server\"}[$__rate_interval])) * 60",
          "legendFormat": "{{mcp_server}} \u00b7 {{mcp_tool}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
