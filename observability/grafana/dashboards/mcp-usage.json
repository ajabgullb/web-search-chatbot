    {
      "type": "bargauge",
      "title": "Failures by error class (selected range)",
      "description": "The error class Claude Code recorded: a type name such as McpToolCallError, never the message. McpToolCallError means the server answered with an error, for example refused SQL.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sort_desc(sum by (mcp_server, error_type) (increase(mcp_tool_errors_total{job=\"mcp\",mcp_server=~\"$server\"}[$__range])))",
          "legendFormat": "{{mcp_server}} \u00b7 {{error_type}}",
          "range": false,
