    {
      "type": "bargauge",
      "title": "Postgres refusals by SQLSTATE (selected range)",
      "description": "Why the database refused SQL from the postgres server. 42501: permission denied (a column grafana_reader can't read). 25006: a write in a read-only transaction. 57014: hit the 5 s statement timeout. 42P01/42703: no such table or column.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sort_desc(sum by (error_sqlstate) (increase(mcp_postgres_refusals_total{job=\"mcp\"}[$__range])))",
          "legendFormat": "SQLSTATE {{error_sqlstate}}",
          "range": false,
          "instant": true
        }
      ],
