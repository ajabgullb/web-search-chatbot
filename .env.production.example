# Production settings for compose.prod.yaml. Copy to .env.production (which
# git ignores), fill in every value, and keep the file out of images and logs.
#
#   docker compose --env-file .env.production -f compose.prod.yaml up -d --build
#
# Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# The public https origin users browse to. TLS is terminated in front of the
# stack; see compose.prod.yaml.
FRONTEND_ORIGIN=https://chat.example.com
WEB_HOST_PORT=8080

# Database. The password must not be a stock one (app, postgres, ...).
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=app

JWT_SECRET=

# Providers.
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
SEARCH_API_KEY=

# Email for password resets. TLS is required: starttls (587) or tls (465).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
EMAIL_FROM=no-reply@chat.example.com

# Bearer token for Prometheus at /api/v1/metrics (32+ characters). Leave empty
# to disable the endpoint.
METRICS_TOKEN=

# Optional LangSmith tracing (inputs and outputs are never uploaded).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=web-search-chatbot
