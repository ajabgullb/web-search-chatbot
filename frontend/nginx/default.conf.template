# Rendered at container start by the image's envsubst step, which replaces
# only variables defined in the environment: ${API_UPSTREAM} and
# ${NGINX_RESOLVER}. nginx's own $variables pass through untouched.

# HSTS only when the request reached us over TLS (terminated in front of this
# server). Sent over plain http it would be ignored anyway; an empty value
# omits the header.
map $http_x_forwarded_proto $hsts_header {
    https   "max-age=31536000; includeSubDomains";
    default "";
}

map $http_x_forwarded_proto $forwarded_proto {
    ""      $scheme;
    default $http_x_forwarded_proto;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # Resolved per request (a variable in proxy_pass), not once at startup: a
    # restarted API container gets a new address. Set at server level so both
    # API locations below share it; the snippet they include cannot hold
    # these two lines, because only this template is filled in by envsubst.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    set $api_upstream ${API_UPSTREAM};

    # The API, same origin: no CORS, and the refresh cookie scoped to
    # /api/v1/auth works exactly as in development.
    location /api/ {
        include /etc/nginx/snippets/api-proxy.conf;
        # Matches the API's MAX_REQUEST_BODY_BYTES; refused here first.
        client_max_body_size 256k;
    }

    # PDF upload (ADR-0015), the one route allowed a large body. A regex
    # location, so it wins over the /api/ prefix above. 11m is the API's
    # MAX_DOCUMENT_BYTES (10 MiB) plus room for the multipart framing; raise
    # both together.
    location ~ ^/api/v1/conversations/[^/]+/documents$ {
        include /etc/nginx/snippets/api-proxy.conf;
        client_max_body_size 11m;
    }

    # add_header in a location replaces, not extends, the server's headers,
    # so each location includes the full set.

    # Hashed assets are immutable; the entry HTML must never be cached.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store" always;
    }

    # Client-side routing: unknown paths fall back to the SPA entry point.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri $uri/ /index.html;
    }
}
