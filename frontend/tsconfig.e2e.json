{
  // Playwright specs run in Node, but page.evaluate() callbacks run in the
  // browser, so these files need both Node and DOM types. Kept separate so
  // the Vite config stays typed as plain Node.
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "lib": ["ES2023", "DOM"]
  },
  "include": ["playwright.config.ts", "tests/e2e/**/*.ts"]
}
