  "paths": {
    "/api/v1/auth/forgot-password": {
      "post": {
        "description": "Always returns the same acknowledgement.\n\nA different status, body, or timing for a known versus unknown address\nwould turn this endpoint into an account-enumeration oracle.",
        "operationId": "forgot_password_api_v1_auth_forgot_password_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotPasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Error envelope returned for every failure."
          }
        },
        "summary": "Forgot Password",
        "tags": [
          "auth"
        ]
      }
    },
