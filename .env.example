# Copy to .env and fill in. Never commit a real .env.
# Values below are development defaults; production startup rejects the weak ones.

# --- Application ---
ENVIRONMENT=development
APP_NAME=Web Search Chatbot
API_V1_PREFIX=/api/v1
# Must be the exact origin the browser uses. If you change WEB_HOST_PORT
# below, change this port too: session refreshes from any other origin are
# refused, which signs you out on every reload.
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO
# json (every deployed environment) or console (readable, for a terminal).
LOG_FORMAT=console

# --- Host port mapping ---
# Only affects what Compose publishes on the host. Change these when another
# project on your machine already owns the default port; container-to-container
# addresses are unaffected.
POSTGRES_HOST_PORT=5432
API_HOST_PORT=8000
WEB_HOST_PORT=5173
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025
REDIS_HOST_PORT=6379

# --- Database ---
# Host-side tools (alembic, pytest) connect through POSTGRES_HOST_PORT above;
# inside the Compose network the host is `postgres` on port 5432.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# --- Redis (optional in development, required in production) ---
# Coordinates API replicas: the one-active-run-per-conversation lock today.
# Empty falls back to in-process coordination (fine for one process only);
# production refuses to start without it. Host-side tools reach Compose's
# Redis through REDIS_HOST_PORT; inside the network it is redis:6379.
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT_SECONDS=2

# --- Auth (Phase 2) ---
# Must be >= 32 characters (RFC 7518 floor for HS256). Production additionally
# rejects this placeholder. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-change-me-not-for-production
JWT_ISSUER=web-search-chatbot
JWT_AUDIENCE=web-search-chatbot-api
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- LLM provider (Phase 5) ---
# Any OpenAI-compatible endpoint: OpenAI, OpenRouter, Groq, or a local Ollama.
# Optional in development (tests use fakes); required in production.
LLM_PROVIDER=openai_compatible
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=1500
LLM_TEMPERATURE=0.2

# --- Search provider (Phase 5) ---
# Optional in development (tests use fakes); required in production.
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
SEARCH_BASE_URL=https://api.tavily.com

# --- Request limits ---
# Bodies larger than this are refused with 413 before parsing.
MAX_REQUEST_BODY_BYTES=262144

# --- Agent budgets (Phase 5) ---
MAX_SEARCHES_PER_RUN=3
MAX_RESULTS_PER_SEARCH=5
SEARCH_TIMEOUT_SECONDS=20
RUN_TIMEOUT_SECONDS=90
MAX_USER_MESSAGE_CHARS=16000
# Most recent conversation messages handed to the model per call.
MAX_CONTEXT_MESSAGES=20

# --- Runs and streaming (Phase 6) ---
# Comment line sent on a quiet stream so proxies do not close it.
SSE_HEARTBEAT_SECONDS=15
# A queued/running run older than RUN_TIMEOUT_SECONDS plus this is presumed
# dead (its process crashed) and stops blocking its conversation.
RUN_STALE_GRACE_SECONDS=60
# A run whose stream dropped keeps going this long for the client to come back
# (a page reload polls GET /runs/{id}); unwatched after that, it is cancelled.
RUN_ABANDON_GRACE_SECONDS=10
# On shutdown, how long runs without an open stream may finish before they
# are stopped and recorded as interrupted (retryable).
SHUTDOWN_DRAIN_SECONDS=10
# Runs started per user per window — the path that spends provider money.
RATE_LIMIT_RUNS=20
RATE_LIMIT_RUNS_WINDOW_SECONDS=60
# Runs one user may start in any rolling 24 hours: caps what an account can spend.
DAILY_RUN_LIMIT_PER_USER=100

# --- Observability (Phase 8) ---
# Prometheus scrapes GET /api/v1/metrics. Development serves it openly. In
# production it needs this bearer token (>= 32 chars), or it is not served.
METRICS_TOKEN=
# Optional LangSmith tracing. Traces carry structure, timings, token counts,
# errors, and version tags; inputs and outputs are never uploaded.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=web-search-chatbot
# Leave empty for the default (US) endpoint.
LANGSMITH_ENDPOINT=

# --- Email (Phase 2, Mailpit in development) ---
SMTP_HOST=localhost
SMTP_PORT=1025
# Production relays need credentials and TLS; production refuses "none",
# because a reset email carries a working credential.
SMTP_USERNAME=
SMTP_PASSWORD=
# none (Mailpit only) | starttls (usually port 587) | tls (usually port 465)
SMTP_SECURITY=none
EMAIL_FROM=no-reply@localhost
# Mailpit never delivers to a real inbox. To send real mail from the Compose
# dev stack, name a relay here and set SMTP_USERNAME, SMTP_PASSWORD,
# SMTP_SECURITY, and EMAIL_FROM above to match it. Leave empty for Mailpit.
DEV_SMTP_HOST=
DEV_SMTP_PORT=

# --- Email verification ---
# Runs need a confirmed address. In development the link lands in Mailpit
# (http://localhost:8025). Production refuses false.
REQUIRE_EMAIL_VERIFICATION=true
EMAIL_VERIFICATION_TTL_HOURS=48
# Confirmation emails one account may request per 5-minute window.
RATE_LIMIT_RESEND_VERIFICATION=3
